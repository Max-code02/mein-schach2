rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Spielerprofil-Daten (Elo, Level, Wins, Losses)
    match /players/{userId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data.username != null;
    }
    
    // Bestenliste, Spiele, Chat & andere Dokumente
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

