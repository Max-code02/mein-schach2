rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 1. Authentifizierungs- & Admin-Prüfungsfunktionen
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'max.schule13@gmail.com') ||
        (request.auth.token.admin == true)
      );
    }

    // 🔒 2. Spieler-Profile (/players/{playerId})
    match /players/{playerId} {
      allow read: if true;

      // 🛡️ Client darf NIEMALS 'is_owner: true' im Dokument ablegen! Nur der MasterAdmin darf dies.
      allow create, update: if (!('is_owner' in request.resource.data) || request.resource.data.is_owner == false || isMasterAdmin());

      allow delete: if true;
    }

    // 🔒 3. Private Benutzerdaten (/users_private/{userId})
    match /users_private/{userId} {
      allow read, write: if true;
    }

    // 🔒 4. Globale Rangliste (/leaderboard/{entryDocId})
    match /leaderboard/{entryDocId} {
      allow read: if true;

      // 🛡️ Auch in der Rangliste darf niemand 'is_owner: true' fälschen!
      allow write: if (!('is_owner' in request.resource.data) || request.resource.data.is_owner == false || isMasterAdmin());
    }

    // 🔒 5. Bann-Listen & IP-Sperren (/bans/{banId})
    match /bans/{banId} {
      allow read, write: if true;
    }

    // 🔒 6. Partien & Snapshots (/games/{gameId})
    match /games/{gameId} {
      allow read, write: if true;
    }

    // 🔒 7. Chat-Nachrichten (/messages/{messageId})
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // 🔒 8. Support-Tickets & Entbannungsanträge (/tickets/{ticketId})
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // 🔒 9. System-Status & Verbindungsüberwachung (/system/{docId})
    match /system/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
