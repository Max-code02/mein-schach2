rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 Hilfsfunktionen zur Authentifizierung & Berechtigungsprüfung
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'max.schule13@gmail.com') ||
        (request.auth.token.admin == true)
      );
    }

    // 1. Spieler-Profile (Elo, Level, Avatar, XP, Themes)
    match /players/{playerId} {
      allow read, write: if true;
    }

    // 2. Private Benutzerdaten
    match /users_private/{userId} {
      allow read, write: if true;
    }

    // 3. Globale Rangliste / Leaderboard
    match /leaderboard/{entryDocId} {
      allow read, write: if true;
    }

    // 4. Bann-Listen (Gesperrte Spieler & IP-Sperren)
    match /bans/{banId} {
      allow read, write: if true;
    }

    // 5. Spielhistorie & Snapshots
    match /games/{gameId} {
      allow read, write: if true;
    }

    // 6. Chat-Nachrichten
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // 7. Support-Tickets & Entbannungsanträge
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // 8. System Status & Verbindungs-Monitoring
    match /system/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
