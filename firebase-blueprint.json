{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "User profile and statistics",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "elo": { "type": "number" },
        "wins": { "type": "number" },
        "losses": { "type": "number" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "ip_address": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["username"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["username", "content"]
    },
    "GameHistory": {
      "title": "GameHistory",
      "description": "Historical logs of finished games with visual snapshots",
      "type": "object",
      "properties": {
        "room_id": { "type": "string" },
        "white_player": { "type": "string" },
        "black_player": { "type": "string" },
        "winner": { "type": "string" },
        "reason": { "type": "string" },
        "snapshot": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["white_player", "black_player"]
    },
    "Ban": {
      "title": "Ban",
      "description": "Banned IP addresses and player accounts",
      "type": "object",
      "properties": {
        "target": { "type": "string" },
        "type": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["target", "type"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Rankings and highscore data for global and seasonal leaderboards",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "name": { "type": "string" },
        "elo": { "type": "number" },
        "wins": { "type": "number" },
        "losses": { "type": "number" },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "role": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["username"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "Support tickets and unban appeals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user": { "type": "string" },
        "contact": { "type": "string" },
        "clientIP": { "type": "string" },
        "email": { "type": "string" },
        "text": { "type": "string" },
        "banReason": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "number" },
        "reply": { "type": "string" }
      },
      "required": ["id", "text"]
    }
  },
  "firestore": {
    "/leaderboard/{entryDocId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Leaderboard highscore entries collection"
    },
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Player collection"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Chat messages collection"
    },
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/GameHistory" },
      "description": "Game history collection with visual snapshots"
    },
    "/bans/{banId}": {
      "schema": { "$ref": "#/entities/Ban" },
      "description": "Banned IPs and accounts"
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/Ticket" },
      "description": "Support tickets and unban appeals"
    }
  }
}
