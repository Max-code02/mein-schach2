{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "User profile and statistics",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "elo": { "type": "number" },
        "wins": { "type": "number" },
        "losses": { "type": "number" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "ip_address": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["username"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["username", "content"]
    },
    "GameHistory": {
      "title": "GameHistory",
      "description": "Historical logs of finished games with visual snapshots",
      "type": "object",
      "properties": {
        "room_id": { "type": "string" },
        "white_player": { "type": "string" },
        "black_player": { "type": "string" },
        "winner": { "type": "string" },
        "reason": { "type": "string" },
        "snapshot": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["white_player", "black_player"]
    }
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Player collection"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Chat messages collection"
    },
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/GameHistory" },
      "description": "Game history collection with visual snapshots"
    }
  }
}
